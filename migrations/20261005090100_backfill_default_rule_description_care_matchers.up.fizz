sql("CREATE PROCEDURE `_r95_matchers`() BEGIN IF EXISTS (SELECT 1 FROM `information_schema`.`TABLES` WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'care_matchers') THEN UPDATE `care_matchers` SET `description` = 'Règles par défaut' WHERE `description` LIKE '%[source: care_plan_converter]'; END IF; END")
sql("CALL `_r95_matchers`()")
sql("DROP PROCEDURE IF EXISTS `_r95_matchers`")
