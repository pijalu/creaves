sql("DELETE t FROM translations t JOIN translations legacy ON legacy.table_name = t.table_name AND legacy.field = t.field AND legacy.locale = t.locale AND legacy.record_id = '0be286c1-b0db-4450-921c-3724e846dbf4' WHERE t.table_name = 'outtaketypes' AND t.record_id = (SELECT id FROM outtaketypes WHERE code = 'OT2' LIMIT 1) AND t.field IN ('name', 'description', 'discoverer_news')")
sql("UPDATE translations SET record_id = (SELECT id FROM outtaketypes WHERE code = 'OT2' LIMIT 1) WHERE table_name = 'outtaketypes' AND field IN ('name', 'description', 'discoverer_news') AND record_id = '0be286c1-b0db-4450-921c-3724e846dbf4' AND EXISTS (SELECT 1 FROM outtaketypes WHERE code = 'OT2')")
