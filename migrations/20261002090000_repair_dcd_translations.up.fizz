sql("DELETE t FROM translations t JOIN outtaketypes tgt ON tgt.id = t.record_id AND tgt.code = 'OT2' JOIN translations legacy ON legacy.table_name = t.table_name AND legacy.field = t.field AND legacy.locale = t.locale AND legacy.record_id IN (SELECT id FROM outtaketypes WHERE name = 'Décédé') WHERE t.table_name = 'outtaketypes'")
sql("UPDATE translations SET record_id = (SELECT id FROM outtaketypes WHERE code = 'OT2' LIMIT 1) WHERE table_name = 'outtaketypes' AND field IN ('name', 'description', 'discoverer_news') AND record_id IN (SELECT id FROM outtaketypes WHERE name = 'Décédé') AND EXISTS (SELECT 1 FROM outtaketypes WHERE code = 'OT2')")
