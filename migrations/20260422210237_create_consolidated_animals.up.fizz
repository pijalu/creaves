create_table("consolidated_animals") {
	t.Column("id", "uuid", {primary: true})
	t.Column("instance_id", "string", {})
	t.Column("animal_id", "integer", {})
	t.Column("year", "integer", {})
	t.Column("year_number", "integer", {})
	t.Column("species", "string", {null: true})
	t.Column("animal_type", "string", {null: true})
	t.Column("animal_age", "string", {null: true})
	t.Column("discovery_location", "string", {null: true})
	t.Column("discovery_date", "timestamp", {null: true})
	t.Column("current_status", "string", {})
	t.Column("intake_date", "timestamp", {null: true})
	t.Column("intake_general", "string", {null: true})
	t.Column("intake_wounds", "string", {null: true})
	t.Column("intake_parasites", "string", {null: true})
	t.Column("intake_remarks", "string", {null: true})
	t.Column("outtake_date", "timestamp", {null: true})
	t.Column("outtake_type", "string", {null: true})
	t.Column("outtake_location", "string", {null: true})
	t.Column("last_event_at", "timestamp", {})
	t.Column("event_count", "integer", {default: 0})
	t.Timestamps()
}

add_index("consolidated_animals", ["instance_id", "animal_id"], {unique: true})
add_index("consolidated_animals", ["instance_id"], {})
add_index("consolidated_animals", ["current_status"], {})
add_index("consolidated_animals", ["species"], {})
add_index("consolidated_animals", ["discovery_date"], {})
