add_column("outtaketypes", "code", "string", {null: true})
sql("DELETE FROM outtaketypes WHERE name IN ('OT1','OT2','OT3','OT4','OT5','OT6','OT7') AND NOT EXISTS (SELECT 1 FROM outtakes WHERE outtakes.outtaketype_id = outtaketypes.id)")
sql("UPDATE outtaketypes SET code='OT1' WHERE name='DCD' AND code IS NULL")
sql("UPDATE outtaketypes SET code='OT2' WHERE name IN ('Relacher','Freed') AND code IS NULL")
sql("UPDATE outtaketypes SET code='OT3' WHERE name IN ('Transferer','Transfer') AND code IS NULL")
sql("UPDATE outtaketypes SET code='OT4' WHERE name='Euthanasier' AND code IS NULL")
sql("UPDATE outtaketypes SET code='OT5' WHERE name='Lost' AND code IS NULL")
sql("UPDATE outtaketypes SET code='OT6' WHERE name='Stolen' AND code IS NULL")
sql("UPDATE outtaketypes SET code='OT7' WHERE name='Other outcome' AND code IS NULL")
sql("UPDATE outtaketypes SET code = CASE code WHEN 'OT1' THEN 'OT2' WHEN 'OT2' THEN 'OT1' WHEN 'OT3' THEN 'OT4' WHEN 'OT4' THEN 'OT3' ELSE code END WHERE code IN ('OT1','OT2','OT3','OT4','OT5','OT6','OT7')")
sql("DELETE t FROM translations t JOIN outtaketypes tgt ON tgt.id = t.record_id AND tgt.code IN ('OT1','OT2','OT3','OT4','OT5','OT6','OT7') JOIN translations legacy ON legacy.table_name = t.table_name AND legacy.field = t.field AND legacy.locale = t.locale JOIN outtaketypes src ON src.id = legacy.record_id AND src.name = CASE tgt.code WHEN 'OT1' THEN 'Relaché' WHEN 'OT2' THEN 'Décédé' WHEN 'OT3' THEN 'Euthanasié' WHEN 'OT4' THEN 'Transféré' WHEN 'OT5' THEN 'Mort à l''arrivée avant l''encodage' WHEN 'OT6' THEN 'Adoption' WHEN 'OT7' THEN 'Doublon' END WHERE t.table_name = 'outtaketypes'")
sql("UPDATE translations t JOIN outtaketypes src ON src.id = t.record_id AND src.name IN ('Relaché','Décédé','Euthanasié','Transféré','Mort à l''arrivée avant l''encodage','Adoption','Doublon') JOIN outtaketypes tgt ON tgt.code = CASE src.name WHEN 'Relaché' THEN 'OT1' WHEN 'Décédé' THEN 'OT2' WHEN 'Euthanasié' THEN 'OT3' WHEN 'Transféré' THEN 'OT4' WHEN 'Mort à l''arrivée avant l''encodage' THEN 'OT5' WHEN 'Adoption' THEN 'OT6' WHEN 'Doublon' THEN 'OT7' END AND tgt.id <> src.id SET t.record_id = tgt.id WHERE t.table_name = 'outtaketypes'")
