create_table("care_rule_exclusions") {
	t.Column("id", "uuid", {primary: true})
	t.Column("rule_id", "uuid", {})
	t.Column("animal_id", "int", {})
	t.Column("reason", "string", {size: 500, null: true})
	t.Column("created_by", "uuid", {null: true})
	t.Timestamps()

	t.ForeignKey("rule_id", {"care_rules": ["id"]}, {
		"on_delete": "CASCADE"
	})
	t.ForeignKey("animal_id", {"animals": ["id"]}, {
		"on_delete": "CASCADE"
	})
	t.ForeignKey("created_by", {"users": ["id"]}, {
		"on_delete": "RESTRICT"
	})
}
add_index("care_rule_exclusions", ["rule_id", "animal_id"], {unique: true})
