sql("UPDATE outtaketypes SET code='OT1' WHERE name = 'Relacher' AND (code IS NULL OR code = '')")
sql("INSERT INTO outtaketypes (id, created_at, updated_at, name, description, def, dead, rating, discoverer_news, error, code, excluded_native_statuses, location_mode) SELECT '0a7e0000-0000-4000-8000-000000000001', NOW(), NOW(), 'Relacher', 'animal is freed', 0, 0, 1, 'Nous sommes heureux de vous informer que, suite à un parcours de soins en notre centre, nous avons pu relâcher l’animal que vous nous aviez confié.', 0, 'OT1', 'NS2,NS3,NS4', 'free' FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM outtaketypes WHERE name = 'Relacher')")
sql("UPDATE outtaketypes SET code='OT2' WHERE name = 'DCD' AND (code IS NULL OR code = '')")
sql("INSERT INTO outtaketypes (id, created_at, updated_at, name, description, def, dead, rating, discoverer_news, error, code, excluded_native_statuses, location_mode) SELECT '0a7e0000-0000-4000-8000-000000000002', NOW(), NOW(), 'DCD', 'animal died', 1, 1, -1, 'Malheureusement, et ce malgré nos bons soins, nous n’avons pas pu sauver l’animal que vous êtes venus nous déposer.', 0, 'OT2', NULL, 'none' FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM outtaketypes WHERE name = 'DCD')")
